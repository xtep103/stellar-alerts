{
  "name": "stellar-alerts",
  "version": "1.0.0",
  "description": "Stellar Payment Tracker",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "node init && npm run dev --workspace=api",
    "dev:worker": "node init && npm run dev:worker --workspace=api",
    "dev:web": "node init && npm run dev --workspace=web",
    "db:push": "npm run db:push --workspace=api",
    "db:migrate": "npm run db:migrate --workspace=api",
    "db:studio": "npm run db:studio --workspace=api",
    "test:api": "npm run test --workspace=api",
    "test": "npm run test --workspaces --if-present"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3"
  }
}
